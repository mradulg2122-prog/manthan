# EventFlow AI - Environment Variables Example
# Copy this file to .env and fill in the values.

# ---- Database ----
# Leave empty for SQLite (local dev). Set for PostgreSQL (production).
DATABASE_URL=
SECRET_KEY=change-me-in-production

# ---- Event Configuration ----
EVENT_NAME=Youth Parliament 6.0
ORGANIZER_NAME=Saturangle Club, GLA University

# ---- SMTP (Email Sending) ----
# Use your email provider's SMTP settings and an App Password (not login password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
