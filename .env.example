# EventFlow AI - Environment Variables Example
# Copy this file to .env and fill in the values.

# ---- Database ----
# Leave empty for SQLite (local dev). Set for PostgreSQL (production).
DATABASE_URL=
SECRET_KEY=change-me-in-production

# ---- Event Configuration ----
EVENT_NAME=Youth Parliament 6.0
ORGANIZER_NAME=Saturangle Club, GLA University

# ---- Gmail API (OAuth 2.0) ----
# Required for sending confirmation emails with QR codes.
# Run: cd backend && python scripts/generate_gmail_token.py
# to generate GMAIL_CLIENT_ID, GMAIL_CLIENT_SECRET, and GMAIL_REFRESH_TOKEN.
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token
GMAIL_SENDER_EMAIL=mradulg2122@gmail.com
