# =============================================================================
# EventFlow AI — Environment Variables Reference
# =============================================================================

# -----------------------------------------------------------------------------
# FastAPI Backend Configuration
# -----------------------------------------------------------------------------
APP_NAME="EventFlow Pro"
DEBUG="False"
HOST="0.0.0.0"
PORT=8000

# Secret key for JWT signing (use a strong random string in production)
SECRET_KEY="your-production-secret-key-here"

# Database Connection
# SQLite (Local Development): sqlite:///./eventflow.db
# PostgreSQL (Render Production): postgresql://user:password@host:5432/dbname
DATABASE_URL="sqlite:///./eventflow.db"

# SMTP Email Configuration (for QR code notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_EMAIL="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# -----------------------------------------------------------------------------
# Frontend Configuration (youth-parliament-portal)
# -----------------------------------------------------------------------------
# Backend API Base URL
# Local: http://localhost:8000
# Production: https://eventflow-backend.onrender.com
VITE_API_URL="http://localhost:8000"
